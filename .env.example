# --- RPC ---
SOLANA_RPC_URL=
# DAS-capable RPC for cNFT lookup (Helius, Triton). Leave blank to disable cNFT sweep.
DAS_RPC_URL=

# --- Recipients ---
# Single recipient
RECIPIENT=
# Or comma-separated for split (takes precedence over RECIPIENT)
RECIPIENTS=

# --- Priority fee ---
PRIORITY_FEE_MODE=dynamic
PRIORITY_FEE_MICRO_LAMPORTS=100000

# --- Compute unit limit (blank = auto per-tx) ---
UNIT_LIMIT=

# --- Jito bundles ---
USE_JITO=false
JITO_TIP_LAMPORTS=100000

# --- Simulation ---
SIMULATE_BEFORE_PLAN=true

# --- Auth ---
REQUIRE_AUTH=true

# --- Feature flags ---
ENABLE_ALT=true
ENABLE_CNFT=true
MAX_CNFT_SWEEP=10

# --- Persistence ---
DATA_DIR=./data

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# --- Bundle URL ---
APP_URL=http://localhost:3000
PORT=3000
